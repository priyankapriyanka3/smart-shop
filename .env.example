# Smart Shop Environment Configuration
# Copy this file to .env and fill in secure values
# DO NOT commit .env to version control - it should be in .gitignore

# SECURITY CRITICAL: JWT Secret
# Generate a strong secret with: openssl rand -base64 32
# This MUST be set before running docker-compose
JWT_SECRET=REPLACE_WITH_OUTPUT_FROM_OPENSSL_RAND_BASE64_32

# Optional: Application Configuration
# Uncomment and customize if needed
# BACKEND_PORT=8000
# CORS_ORIGINS=http://localhost:80,http://localhost:5173
# DEBUG=true
# JWT_EXPIRATION_HOURS=24

# Payment Provider Configuration (Production only)
# PAYMENT_PROVIDER_URL=https://api.payment-provider.com
# PAYMENT_PROVIDER_API_KEY=your_secure_api_key_here
