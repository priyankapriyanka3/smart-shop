# Database Configuration
# SQLite (default for development)
DATABASE_URL=sqlite:///./app.db
# PostgreSQL (for production)
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/smartshop

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Application Configuration
DEBUG=true
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Payment Provider (mock in development)
PAYMENT_PROVIDER_URL=http://localhost:9000/mock-payment
PAYMENT_PROVIDER_API_KEY=mock-api-key

# Default seed credentials (for development/testing only)
# Admin: admin@example.com / Admin123!
# Customer: customer@example.com / Customer123!
# Inventory Manager: inventory@example.com / Inventory123!
# Customer Support: support@example.com / Support123!
