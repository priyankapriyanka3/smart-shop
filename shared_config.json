{
  "api_base_path": "/api/v1",
  "ports": {
    "backend": 9000,
    "frontend_web": 5173
  },
  "auth": {
    "storage_key": "smart_shop_token",
    "login_request": {
      "field_names": {
        "email": "email",
        "password": "password"
      }
    },
    "login_response": {
      "token_field": "access_token",
      "user_field": "user"
    }
  },
  "pagination": {
    "default_page_size": 20,
    "max_page_size": 100
  },
  "cors_origins": [
    "http://localhost:5173",
    "http://localhost:3000"
  ]
}