# Development environment configuration
# This file provides working defaults for local development.
# Copy to .env and customize as needed.
# SECURITY WARNING: This file contains a development-only JWT secret.
# NEVER use this in production. Generate a secure secret with: openssl rand -base64 32

# Database Configuration
DATABASE_URL=sqlite:///./app.db

# JWT Configuration
# DEVELOPMENT ONLY - Replace with secure secret for production
# Generate with: openssl rand -base64 32
JWT_SECRET=DEV_ONLY_SECRET_REPLACE_IN_PRODUCTION_1234567890abcdefghijklmnopqrstuvwxyz
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Application Configuration
DEBUG=true
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Payment Provider (mock in development)
PAYMENT_PROVIDER_URL=http://localhost:9000/mock-payment
PAYMENT_PROVIDER_API_KEY=mock-api-key
