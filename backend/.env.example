# Environment Configuration Template
# Copy this file to .env and fill in secure values
# DO NOT commit .env to version control

# Database Configuration
DATABASE_URL=sqlite:///./app.db

# JWT Configuration (REQUIRED - generate with: openssl rand -base64 32)
# SECURITY CRITICAL: Use a strong, randomly generated secret
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_FROM_OPENSSL_COMMAND
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Application Configuration
DEBUG=true
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Payment Provider Configuration
# For development: use mock values
# For production: use actual provider credentials
PAYMENT_PROVIDER_URL=
PAYMENT_PROVIDER_API_KEY=
