# Docker build context exclusions
# Exclude development files and build artifacts from Docker images

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Git
.git/
.gitignore

# Databases
*.db
*.sqlite
*.sqlite3

# Environment files
.env
.env.local

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Documentation
*.md
docs/
