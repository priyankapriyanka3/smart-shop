# Frontend Dockerfile for Smart Shop React application
# Multi-stage build: 1) Build static assets, 2) Serve with nginx

# Stage 1: Build the frontend application
FROM node:22-slim as build

WORKDIR /app

# Copy dependency files
COPY frontend/package.json frontend/package-lock.json /app/

# Install dependencies
RUN npm ci

# Copy source code
COPY frontend/ /app/

# Build argument for backend host (used by nginx proxy)
ARG BACKEND_HOST=backend

# Build the application
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine

# Set backend host as environment variable for nginx templating
ARG BACKEND_HOST=backend
ENV BACKEND_HOST=${BACKEND_HOST}

# Copy nginx configuration template
COPY deployment/nginx.conf.template /etc/nginx/templates/default.conf.template

# Copy built assets from build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Expose frontend port
EXPOSE 80

# Preview port annotation
LABEL x-preview-port=80

# Nginx starts automatically via base image entrypoint
